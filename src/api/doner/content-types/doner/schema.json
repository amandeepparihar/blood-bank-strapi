{
  "kind": "collectionType",
  "collectionName": "doners",
  "info": {
    "singularName": "doner",
    "pluralName": "doners",
    "displayName": "Doner"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "gender": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Male",
        "Female",
        "Others"
      ]
    },
    "dob": {
      "type": "date",
      "required": true
    },
    "bloodGroup": {
      "type": "enumeration",
      "required": true,
      "default": "A-positive",
      "enum": [
        "A-positive",
        "A-negative",
        "B-positive",
        "B-negative",
        "O-positive",
        "O-negative"
      ]
    },
    "mobileNo": {
      "type": "biginteger",
      "required": true,
      "unique": true
    },
    "email": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "late_date_of_donation": {
      "type": "date"
    },
    "donated_previously": {
      "type": "boolean",
      "required": true
    },
    "last_six_months_have_you_had_any_of_the_following": {
      "type": "enumeration",
      "default": "No",
      "enum": [
        "No",
        "Tattooing",
        "Piercing",
        "Dental extraction"
      ]
    },
    "agree_to_be_contacted": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "doners"
    },
    "district": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::district.district",
      "inversedBy": "doners"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "doners"
    }
  }
}
