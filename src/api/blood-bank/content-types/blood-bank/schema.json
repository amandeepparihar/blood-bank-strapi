{
  "kind": "collectionType",
  "collectionName": "blood_banks",
  "info": {
    "singularName": "blood-bank",
    "pluralName": "blood-banks",
    "displayName": "Blood Bank"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "contactNo": {
      "type": "biginteger",
      "required": true,
      "unique": true
    },
    "address": {
      "type": "text",
      "required": true
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "required": true,
      "inversedBy": "blood_banks"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "required": true,
      "inversedBy": "blood_banks"
    }
  }
}
