{
  "kind": "collectionType",
  "collectionName": "cities",
  "info": {
    "singularName": "city",
    "pluralName": "cities",
    "displayName": "City"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "cityName": {
      "type": "string",
      "required": true
    },
    "district": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::district.district",
      "inversedBy": "cities"
    },
    "donations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::donation.donation",
      "mappedBy": "city"
    },
    "doners": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doner.doner",
      "mappedBy": "city"
    },
    "blood_banks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blood-bank.blood-bank",
      "mappedBy": "city"
    }
  }
}
